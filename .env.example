NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=skygraph
NEO4J_DATABASE=neo4j

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://sky-graph-frontend.vercel.app
# Regex matching Vercel preview deployments; set to an empty value to disable.
CORS_ORIGIN_REGEX=https://sky-graph-frontend-[a-z0-9-]+\.vercel\.app

# Host ports (override if these clash with something else on your machine)
API_PORT=8000
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
